[Unit]
Description=GitHub webhook receiver for yczx music vote updates
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/node /srv/yczx_musicvote/scripts/webhook-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/yczx_musicvote /etc/yczx-musicvote/webhook-secret
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
